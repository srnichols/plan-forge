ARG NODE_VERSION=24
FROM node:${NODE_VERSION}-slim AS build
WORKDIR /app
COPY package.json ./
RUN npm install --omit=dev --ignore-scripts
COPY cli.mjs config.schema.json ./
COPY src/ ./src/
COPY examples/ ./examples/

FROM node:${NODE_VERSION}-slim
RUN groupadd -g 10001 claw \
    && useradd -u 10001 -g 10001 -M claw \
    && mkdir /data \
    && chown 10001:10001 /data
ENV PFORGE_CLAW_HOME=/data NODE_ENV=production PFORGE_CLAW_HTTP_PORT=3190
COPY --from=build --chown=10001:10001 /app /app
WORKDIR /app
VOLUME /data
EXPOSE 3190
USER 10001:10001
HEALTHCHECK --interval=30s --timeout=5s CMD ["node","-e","fetch('http://127.0.0.1:'+(process.env.PFORGE_CLAW_HTTP_PORT||3190)+'/healthz').then(r=>process.exit(r.ok?0:1),()=>process.exit(1))"]
ENTRYPOINT ["node","cli.mjs"]
CMD ["start"]
