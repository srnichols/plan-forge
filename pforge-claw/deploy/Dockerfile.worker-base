ARG NODE_VERSION=24
FROM node:${NODE_VERSION}-slim AS build
WORKDIR /app
COPY package.json ./
RUN npm install --omit=dev --ignore-scripts
COPY cli.mjs config.schema.json ./
COPY src/ ./src/
COPY deploy/worker-entrypoint.mjs ./deploy/

FROM node:${NODE_VERSION}-slim
ARG TARGETARCH
ARG PWSH_VERSION=7.4.6
ARG COPILOT_CLI_VERSION=latest
LABEL io.pforge.claw.d4="container-copilot-auth=supported; runtime token PFORGE_CLAW_COPILOT_TOKEN -> COPILOT_GITHUB_TOKEN; absent => BYOK-only"
LABEL com.azure.containerizationassist.createdby="containerization-assist"

RUN apt-get update \
    && apt-get install -y --no-install-recommends bash ca-certificates curl git gnupg libicu-dev \
    && rm -rf /var/lib/apt/lists/*

RUN install -d -m 0755 /etc/apt/keyrings \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && chmod 0644 /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && printf 'deb [arch=%s signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main\n' "$(dpkg --print-architecture)" > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/*

COPY deploy/install-powershell.mjs /usr/local/share/pforge-claw/install-powershell.mjs
RUN node /usr/local/share/pforge-claw/install-powershell.mjs "$PWSH_VERSION" "$TARGETARCH" /opt/microsoft/powershell/7 \
    && ln -s /opt/microsoft/powershell/7/pwsh /usr/local/bin/pwsh \
    && pwsh -v

RUN npm install --global "@github/copilot@${COPILOT_CLI_VERSION}" \
    && npm cache clean --force

RUN groupadd --gid 10001 claw \
    && useradd --uid 10001 --gid 10001 --create-home --home-dir /var/lib/claw claw \
    && mkdir -p /work /data \
    && chown 10001:10001 /work /data

COPY --from=build /app /app
RUN printf '%s\n' \
      '#!/bin/sh' \
      'exec node /app/deploy/worker-entrypoint.mjs "$@"' \
      > /usr/local/bin/pforge \
    && chmod 0755 /usr/local/bin/pforge

ENV PFORGE_CLAW_HOME=/work/claw NODE_ENV=production HOME=/work/home
WORKDIR /work
USER 10001:10001
HEALTHCHECK NONE
# Kubernetes Secrets provide PFORGE_CLAW_GH_TOKEN and PFORGE_CLAW_COPILOT_TOKEN at runtime; never pass credentials as build arguments.
# One-shot workers have no listener; Job status and authenticated LaneEvents are their health contract.
ENTRYPOINT ["pforge","claw","worker","--one-shot"]
