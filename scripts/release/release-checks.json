{
  "$comment": [
    "Per-release expectations for scripts/release/rehearse.mjs and verify-public.mjs (#300).",
    "Each check runs against every consumer project after setup or update. Add an entry for each",
    "user-visible fix a release delivers, and update the model default when it changes.",
    "Fields: label, path (relative to the consumer), then one of: nothing (file exists),",
    "contains, notContains, or jsonKey + equals. Optional: preset (only for that preset),",
    "when: \"fresh\" (fresh installs only) or \"current-wrapper\" (skipped right after an update",
    "run by the previous release's wrapper, which cannot have this release's update logic)."
  ],
  "checks": [
    { "label": "hooks use hidden PowerShell launchers (meta #287)", "path": ".github/hooks/plan-forge.json", "contains": "-WindowStyle Hidden" },
    { "label": "check-diff-classify.mjs hook delivered", "path": ".github/hooks/scripts/check-diff-classify.mjs" },
    { "label": "check-forbidden.ps1 reads $hookInput", "path": ".github/hooks/scripts/check-forbidden.ps1", "contains": "$hookInput" },
    { "label": "git-diff-reader.mjs delivered", "path": "pforge-mcp/server/git-diff-reader.mjs" },
    { "label": "testbed resolver has no personal default path", "path": "pforge-mcp/testbed/scenarios.mjs", "notContains": "E:\\\\GitHub" },
    { "label": "pforge.ps1 doctor reports the default model", "path": "pforge.ps1", "contains": "default (claude-opus-5.5)" },
    { "label": "pforge.sh doctor reports the default model", "path": "pforge.sh", "contains": "default (claude-opus-5.5)" },
    { "label": "pforge.sh dispatch survives self-replacement", "path": "pforge.sh", "contains": "# The dispatch is one brace group" },
    { "label": "update-guard.mjs delivered (#280)", "path": "pforge-mcp/update-guard.mjs" },
    { "label": "shipped-guidance-hashes.json delivered (#280)", "path": "pforge-mcp/shipped-guidance-hashes.json" },
    { "label": "copilot-pricing.json delivered (#295)", "path": "pforge-mcp/copilot-pricing.json" },
    { "label": "model-retirements.mjs delivered (recommender skips retired models)", "path": "pforge-mcp/model-retirements.mjs" },
    { "label": "model-retirements.json delivered (#303)", "path": "pforge-mcp/model-retirements.json" },
    { "label": "grok worker defaults to grok-4.7", "path": "pforge-mcp/worker-capabilities.json", "contains": "\"defaultModel\": \"grok-4.7\"" },
    { "label": "Forge-Master Copilot SDK tools delivered (#294)", "path": "pforge-master/src/providers/copilot-sdk-tools.mjs" },
    { "label": "modelRouting.default is the current default", "path": ".forge.json", "jsonKey": "modelRouting.default", "equals": "claude-opus-5.5", "when": "fresh" },
    { "label": "typescript deploy instructions use node:24-slim", "path": ".github/instructions/deploy.instructions.md", "contains": "node:24-slim", "preset": "typescript" },
    { "label": "dotnet deploy instructions are the dotnet preset", "path": ".github/instructions/deploy.instructions.md", "contains": "aspnet", "preset": "dotnet" },
    { "label": "Node.js 22.12 floor (3.29)", "path": "pforge-mcp/package.json", "contains": "\">=22.12.0\"" },
    { "label": "node-support.mjs delivered for smith's Node check (3.29)", "path": "pforge-mcp/node-support.mjs" },
    { "label": "pforge pending module delivered (#302)", "path": "pforge-mcp/update-pending.mjs" },
    { "label": "pforge.ps1 has the pending command (#302)", "path": "pforge.ps1", "contains": "function Invoke-Pending" },
    { "label": "pforge.sh has the pending command (#302)", "path": "pforge.sh", "contains": "cmd_pending()" },
    { "label": "detect-preset.mjs delivered (update without .forge.json)", "path": "pforge-mcp/detect-preset.mjs" },
    { "label": "hook-status.mjs delivered (smith hooks, no jq)", "path": "pforge-mcp/hook-status.mjs" },
    { "label": "migrate-forge-config.mjs delivered (#299 migration gap)", "path": "pforge-mcp/migrate-forge-config.mjs" },
    { "label": ".forge.json has hooks.postRun (setup seeds it, update migrates it)", "path": ".forge.json", "jsonKey": "hooks.postRun.invokeAuditor.onFailure", "equals": false, "when": "current-wrapper" },
    { "label": "Copilot SDK route is the default (#307)", "path": "pforge-mcp/orchestrator/worker-spawn.mjs", "contains": "const DEFAULT_COPILOT_SDK_PREF = \"prefer\";" }
  ]
}
