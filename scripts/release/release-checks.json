    { "label": "model-retirements.json delivered (#303)", "path": "pforge-mcp/model-retirements.json" },
    { "label": "grok worker defaults to grok-4.7", "path": "pforge-mcp/worker-capabilities.json", "contains": "\"defaultModel\": \"grok-4.7\"" },
    { "label": "time-units.mjs delivered (imported by memory.mjs and tempering.mjs)", "path": "pforge-mcp/time-units.mjs" },
    { "label": "worker timeout ends the whole process tree (#313)", "path": "pforge-mcp/orchestrator/worker-spawn.mjs", "contains": "export function killWorkerTree" },
