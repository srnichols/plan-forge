    { "label": "test-files.mjs delivered (imported by impact-gate and regression-guard)", "path": "pforge-mcp/test-files.mjs" },
    { "label": "retries resume the worker session (3.31)", "path": "pforge-mcp/orchestrator/worker-session.mjs" },
    { "label": "Copilot CLI workers pin their session (3.31)", "path": "pforge-mcp/worker-capabilities.json", "contains": "\"sessionArg\": \"--session-id={SESSION_ID}\"" },
    { "label": "Copilot SDK 1.0.16 (3.31)", "path": "pforge-mcp/package.json", "contains": "\"@github/copilot-sdk\": \"^1.0.16\"" },
    { "label": "Forge-Master identifies itself to the Copilot runtime (3.31)", "path": "pforge-master/src/providers/copilot-sdk-tools.mjs", "contains": "integrationName: \"forge-master\"" },
    { "label": "live Copilot model list (3.31)", "path": "pforge-mcp/orchestrator/copilot-live-models.mjs" },
    { "label": "SDK auto tiers for auto slices (3.31)", "path": "pforge-mcp/orchestrator/auto-tier.mjs" },
    { "label": "gate tool preflight (3.31)", "path": "pforge-mcp/orchestrator/gate-preflight.mjs" },
    { "label": "gates can run in a Dev Container (3.31)", "path": "pforge-mcp/orchestrator/devcontainer-gates.mjs" },
    { "label": "stale worktrees are cleaned up (3.31)", "path": "pforge-mcp/orchestrator/worktree-janitor.mjs" },
    { "label": "every orchestrator event reaches the log (3.31)", "path": "pforge-mcp/orchestrator/event-bus.mjs", "contains": "emit(type, ...args)" },
    { "label": "MCP server lists the core tool profile (3.31)", "path": "pforge-mcp/server/mcp-handler.mjs", "contains": "toolProfiles.listedTools(TOOLS)" },
    { "label": "Forge-Master asks for every tool (3.31)", "path": "pforge-master/src/mcp-client.mjs", "contains": "PFORGE_TOOL_PROFILE: \"full\"" },
    { "label": "pforge.ps1 update guards automation templates (3.31)", "path": "pforge.ps1", "contains": "skills|hooks|automations)/" },
    { "label": "pforge.sh update guards automation templates (3.31)", "path": "pforge.sh", "contains": "skills|hooks|automations)/" },
    { "label": "VS Code automation templates installed (3.31)", "path": ".github/automations/pforge-daily-drift.automation.md", "contains": "id: pforge-daily-drift", "when": "current-wrapper" },
    { "label": "repo-only 3.31 suites are skipped in installed projects (3.31.1)", "path": "pforge-mcp/vitest.config.mjs", "contains": "\"tests/release-ship.test.mjs\"" },
    { "label": "tests do not call the Copilot runtime for models (3.31.1)", "path": "pforge-mcp/vitest.config.mjs", "contains": "PFORGE_LIVE_MODELS: \"0\"" },
    { "label": "update lists files a release removed (3.31.2)", "path": "pforge-mcp/update-plan.mjs", "contains": "function scanRemovedPackageFiles" },
    { "label": "smith detects half-applied upgrades (3.31.2)", "path": "pforge-mcp/install-consistency.mjs" },
    { "label": "pforge.ps1 self-update reruns with the new wrapper (3.31.2)", "path": "pforge.ps1", "contains": "function Invoke-SelfUpdateSecondPass" },
    { "label": "pforge.sh self-update reruns with the new wrapper (3.31.2)", "path": "pforge.sh", "contains": "_pf_self_update_second_pass()" },
    { "label": "estimates price measured cache shares (3.31.2)", "path": "pforge-mcp/cost-service.mjs", "contains": "export function cacheSharesFromHistory" },
    { "label": "runs record cache tokens in cost history (3.31.2)", "path": "pforge-mcp/orchestrator/run-plan.mjs", "contains": "total_cache_read_tokens" },
    { "label": "background run-plan log is UTF-8 on Windows (3.31.2)", "path": "pforge.ps1", "contains": "function Get-BackgroundHostCommand" }
  ]
}
